{
  "name": "esch",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "dist/src/desktop/main.js",
  "bin": {
    "esch": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json --noEmit && vite build",
