{
  "name": "snaffle",
  "productName": "Snaffle",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "dist/src/desktop/main.js",
  "bin": {
    "snaffle": "dist/src/cli.js",
    "esch": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json --noEmit && vite build",
    "prepare:ketch": "node scripts/install-ketch.mjs",
    "desktop": "npm run prepare:ketch && npm run build && node scripts/run-desktop.mjs",
    "start": "node dist/src/cli.js",
    "benchmark:edit": "npm run build && node --env-file-if-exists=.env benchmark/edit-protocol.mjs",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@firecrawl/anydoc": "^0.1.3",
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-pixel": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@libsql/client": "^0.17.4",
    "@mozilla/readability": "^0.6.0",
    "@vscode/ripgrep": "^1.18.0",
    "highlight.js": "^11.11.1",
    "linkedom": "^0.18.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.2.0",
    "typescript": "^5.0.0",
    "vite": "^8.2.0"
  }
}
